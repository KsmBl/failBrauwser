# ISO images open like folders.
open $T/w
select disc.iso
activate
expect-location $T/w/disc.iso
expect-rows 2
select docs
activate
expect-rows 1
select a.txt
action win.copy
open $T/w/out
action win.paste
wait-exists $T/w/out/a.txt
# ISO images can be edited: paste, new folder, rename, delete.
open $T/w
select new.txt
action win.copy
open $T/w/disc.iso
action win.paste
wait-row new.txt
text Fresh
action win.new-folder
wait-row Fresh
select readme.txt
text README-renamed.txt
action win.rename
wait-row README-renamed.txt
select new.txt
action win.delete
wait-no-row new.txt
# Hybrid images (USB-bootable) stay read-only.
open $T/w/hybrid.iso
expect-disabled win.paste
expect-disabled win.new-folder

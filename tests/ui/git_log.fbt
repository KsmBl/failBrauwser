# TortoiseGit's Log Messages, TortoiseGitMerge and TortoiseGitBlame.
open $T/repo
click-empty
git-menu Repository/Show log
wait-git-window Log Messages - TortoiseGit
wait-git-log Log Messages = [main,v1] Second commit | First commit
git-log-select Log Messages : Second commit
wait-git-rows Log Messages - TortoiseGit : log-files = changed.txt Modified
wait-git-text Log Messages - TortoiseGit : SHA-1:
wait-git-text Log Messages - TortoiseGit : Showing 2 revision(s)
git-activate Log Messages - TortoiseGit : log-files : changed.txt
wait-git-diff TortoiseGitMerge = = one | = two | = three | + four
git-close TortoiseGitMerge
git-snapshot Log Messages - TortoiseGit = $T/log.png
# The filter.
git-set Log Messages - TortoiseGit : filter = First
wait-git-log Log Messages = First commit
git-set Log Messages - TortoiseGit : filter = 
wait-git-log Log Messages = [main,v1] Second commit | First commit
# A tag at a commit, from its right-click menu.
git-log-select Log Messages : First commit
git-log-menu Log Messages : Create Tag at this version...
wait-git-window Create Tag - TortoiseGit
git-set Create Tag - TortoiseGit : tag-name = v0
git-snapshot Create Tag - TortoiseGit = $T/tag.png
git-click Create Tag - TortoiseGit : OK
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
git-close Log Messages
# The log of one file: only the commits that changed it.
select clean.txt
git-menu Repository/Show log
wait-git-log Log Messages = [v0] First commit
git-close Log Messages
# Diff with previous version, Blame and Diff of a changed file.
select changed.txt
git-menu Repository/Diff with previous version
wait-git-diff TortoiseGitMerge = = one | = two | = three | + four
git-close TortoiseGitMerge
git-menu Repository/Blame
wait-git-blame TortoiseGitBlame = Ann Tester: one | Ann Tester: two | Ann Tester: three | Ann Tester: four
git-snapshot TortoiseGitBlame = $T/blame.png
git-close TortoiseGitBlame
git-menu Repository/Diff
wait-git-diff TortoiseGitMerge = = one | ~ two|TWO | = three | = four
git-snapshot TortoiseGitMerge = $T/diff-working.png
git-close TortoiseGitMerge
quit

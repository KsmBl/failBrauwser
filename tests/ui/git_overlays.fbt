# TortoiseGit's overlay icons and its items in the right-click menu.
open $T/repo
# Off until switched on in Edit → Version Control Integration: no overlays, no version-control menu.
wait-git-idle
wait-git-overlay clean.txt = none
select clean.txt
expect-no-git-menu Git Commit -> "main"...
expect-no-menu-item TortoiseGit
action app.vcs-integration
click-empty
wait-git-overlay clean.txt = Normal
wait-git-overlay changed.txt = Modified
wait-git-overlay added.txt = Added
wait-git-overlay new.txt = Unversioned
wait-git-overlay build.log = Ignored
wait-git-overlay src = Modified
wait-git-overlay docs = Normal
# A file changed: the folder changes, the overlay follows.
write-file $T/repo/clean.txt = edited
wait-git-overlay clean.txt = Modified
# A commit made elsewhere: the repository is watched.
run cd $T/repo && git commit -qam elsewhere
wait-git-overlay clean.txt = Normal
wait-git-overlay changed.txt = Normal
wait-git-overlay added.txt = Normal
wait-git-overlay src = Normal
# The menu of a versioned file, as in Explorer.
select clean.txt
expect-git-menu Git Sync...
expect-git-menu Git Commit -> "main"...
expect-git-menu Repository/Pull...
expect-git-menu Repository/Show log
expect-git-menu Repository/Diff with previous version
expect-git-menu Repository/Blame
expect-git-menu Repository/Rename...
expect-git-menu Repository/Settings
expect-no-git-menu Repository/Diff
expect-no-git-menu Repository/Add...
expect-no-git-menu Repository/Clone...
# An unversioned file: Add and the ignore list.
select new.txt
expect-git-menu Repository/Add...
expect-git-menu Repository/Add to ignore list/new.txt
expect-git-menu Repository/Add to ignore list/*.txt
expect-no-git-menu Repository/Delete
# The folder above: each working tree shows its state; Clone and Create repository here.
open $T
wait-git-overlay repo = Normal
wait-git-overlay plain = none
run echo more >> $T/repo/clean.txt
action win.reload
wait-git-overlay repo = Modified
click-empty
expect-git-menu Repository/Clone...
expect-git-menu Repository/Create repository here...
expect-git-menu Repository/About
expect-no-git-menu Git Sync...
select repo
expect-git-menu Git Commit -> "main"...
# How it looks: the overlays, and the menu with the Repository submenu open.
open $T/repo
wait-git-overlay clean.txt = Modified
window-snapshot $T/overlays.png
right-click new.txt
expect-context-menu file
git-open-submenu Repository
sleep 400
screenshot $T/menu.png
close-context-menu
action win.view-mode icons
sleep 300
window-snapshot $T/overlays-icons.png
quit

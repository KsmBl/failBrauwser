# The drives page lists the root filesystem and returns to the file view.
open $T/d
action win.drives
expect-location drives:///
wait-drive File System
action win.back
expect-location $T/d
expect-rows 1
# Drives from the side panel.
sidebar-drives
expect-location drives:///
expect-sidebar-drives selected
expect-crumbs Drives
action win.back
expect-sidebar-drives unselected
# Drive properties open without trouble.
action win.drives
wait-drive File System
drive-properties File System
sleep 300
action win.properties
sleep 300
# The Drives entry is only marked while the drives page is shown.
open $T/d
expect-sidebar-drives unselected
# On the drives page a click below the drives deselects and ends path editing.
action win.drives
wait-drive File System
drives-select File System
expect-drive-selected File System
drives-click-empty
expect-drive-selected none
path-edit
expect-path-mode text
drives-click-empty
expect-path-mode buttons
# Switching between list and icons keeps the drives shown; folders then use the new view.
action win.view-mode icons
expect-page drives
wait-drive File System
action win.back
expect-page icons
action win.view-mode list
expect-page list
action win.drives
action win.view-mode list
expect-page drives

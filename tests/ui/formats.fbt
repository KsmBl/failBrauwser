# Less common archives and disk images open like folders on double click.
open $T/w
select old.lzh
activate
expect-location $T/w/old.lzh
wait-row a.txt
open $T/w
select disk.img
activate
expect-location $T/w/disk.img
wait-row a.txt
open $T/w
select floppy.adf
activate
expect-location $T/w/floppy.adf
wait-row a.txt
open $T/w
select root.sqfs
activate
expect-location $T/w/root.sqfs
wait-row a.txt
# A compressed file shows the file inside; Extract Here gives that file.
open $T/w
select notes.txt.br
activate
expect-location $T/w/notes.txt.br
wait-row notes.txt
open $T/w
select notes.txt.br
action win.extract-here
wait-exists $T/w/notes.txt
# Compress writes any format: picked by its suffix, or explicitly (a FAT image).
open $T/w
select pack
text pack.lzh
action win.compress
wait-exists $T/w/pack.lzh
select pack.lzh
activate
wait-row pack
open $T/w
select pack
text pack|Fat
action win.compress
wait-exists $T/w/pack.img
select pack.img
activate
wait-row pack
# A single file can become a compressed file.
open $T/w
select notes.txt
text notes.txt.xz
action win.compress
wait-exists $T/w/notes.txt.xz
select notes.txt.xz
activate
wait-row notes.txt

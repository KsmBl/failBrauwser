# Branches: Create Branch, Switch/Checkout, Merge with a conflict, Resolve, Create Tag, Reset.
open $T/repo
click-empty
git-menu TortoiseGit/Create Branch...
wait-git-window Create Branch - TortoiseGit
git-set Create Branch - TortoiseGit : branch-name = feature
git-set Create Branch - TortoiseGit : switch = on
git-snapshot Create Branch - TortoiseGit = $T/branch.png
git-click Create Branch - TortoiseGit : OK
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
expect-git-menu Git Commit -> "feature"...
write-file $T/repo/clean.txt = feature side
wait-git-overlay clean.txt = Modified
git-menu Git Commit -> "feature"...
wait-git-rows Commit - TortoiseGit : changes = +clean.txt Modified
git-set Commit - TortoiseGit : message = On feature
git-click Commit - TortoiseGit : Commit
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
# Back to main.
git-menu TortoiseGit/Switch/Checkout...
wait-git-window Switch/Checkout - TortoiseGit
git-set Switch/Checkout - TortoiseGit : base-branch-name = main
git-snapshot Switch/Checkout - TortoiseGit = $T/switch.png
git-click Switch/Checkout - TortoiseGit : OK
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
expect-git-menu Git Commit -> "main"...
write-file $T/repo/clean.txt = main side
wait-git-overlay clean.txt = Modified
git-menu Git Commit -> "main"...
wait-git-rows Commit - TortoiseGit : changes = +clean.txt Modified
git-set Commit - TortoiseGit : message = On main
git-click Commit - TortoiseGit : Commit
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
# Merging feature conflicts.
git-menu TortoiseGit/Merge...
wait-git-window Merge - TortoiseGit
git-set Merge - TortoiseGit : base-branch-name = feature
git-snapshot Merge - TortoiseGit = $T/merge.png
git-click Merge - TortoiseGit : OK
wait-git-result Git Command Progress = git did not exit cleanly
git-click Git Command Progress : Close
wait-git-overlay clean.txt = Conflicted
expect-git-menu TortoiseGit/Resolve...
select clean.txt
git-menu TortoiseGit/Resolve...
wait-git-rows Resolve - TortoiseGit : files = +clean.txt Conflicted
write-file $T/repo/clean.txt = merged
git-click Resolve - TortoiseGit : OK
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
wait-git-overlay clean.txt = Modified
click-empty
git-menu Git Commit -> "main"...
wait-git-rows Commit - TortoiseGit : changes = +clean.txt Modified
git-set Commit - TortoiseGit : message = Merge feature
git-click Commit - TortoiseGit : Commit
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
wait-git-overlay clean.txt = Normal
# An annotated tag.
git-menu TortoiseGit/Create Tag...
wait-git-window Create Tag - TortoiseGit
git-set Create Tag - TortoiseGit : tag-name = v2
git-set Create Tag - TortoiseGit : message = Release two
git-click Create Tag - TortoiseGit : OK
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
# Reset main back to before the merge, from the log.
git-menu TortoiseGit/Show log
wait-git-window Log Messages - TortoiseGit
git-set Log Messages - TortoiseGit : all-branches = on
wait-git-log Log Messages = [main,v2] Merge feature | [feature] On feature | On main | [v1] Second commit | First commit
git-snapshot Log Messages - TortoiseGit = $T/log-graph.png
git-log-select Log Messages : On main
git-log-menu Log Messages : Reset "main" to this...
wait-git-window Reset - TortoiseGit
git-set Reset - TortoiseGit : hard = on
git-snapshot Reset - TortoiseGit = $T/reset.png
git-click Reset - TortoiseGit : OK
wait-git-result Git Command Progress = Success
git-click Git Command Progress : Close
git-close Log Messages
wait-file-text $T/repo/clean.txt = main side
quit

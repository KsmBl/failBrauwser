# The Total Size column adds up folders recursively without following symlinks.
action win.column-dirsize
open $T/root
wait-cell dirsize photos = 3.5 kB
wait-cell dirsize with-link = 10 bytes
wait-cell dirsize note.txt = 5 bytes
wait-cell size photos = 
# Switching the column off and on again recomputes.
action win.column-dirsize
action win.column-dirsize
wait-cell dirsize photos = 3.5 kB

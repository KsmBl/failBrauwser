# Encrypted archives: create with a password, enter (asks), open a file; extract asks too.
open $T/w
select doc.txt
text secret.zip
text hunter2
action win.compress
wait-exists $T/w/secret.zip
text hunter2
open $T/w/secret.zip
wait-row doc.txt
select doc.txt
activate
wait-opened
# A 7z whose entries do not show as encrypted: extracting asks, then works.
open $T/w
select plan.txt
text locked.7z
text s3cret
action win.compress
wait-exists $T/w/locked.7z
select locked.7z
text s3cret
action win.extract-here
wait-exists $T/w/locked/plan.txt
